{
  "name": "studiply",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:local": "expo start --clear",
    "start:remote": "node scripts/start-remote.mjs",
    "build:dev:ios": "eas build --profile development --platform ios",
    "editor:build": "vite build --config editor-web/vite.config.mts",
    "editor:dev": "vite build --config editor-web/vite.config.mts --watch",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "deno check --no-lock --node-modules-dir=none supabase/functions/*/index.ts",
    "lint": "expo lint",
    "test": "jest",
    "test:db": "supabase test db --local",
    "gen:types": "supabase gen types typescript --local --schema public > src/types/supabase.ts",
    "check:storage": "node scripts/check-storage-local.mjs",
    "check:transcribe": "node scripts/check-transcribe-local.mjs",
    "check:claude": "node scripts/check-claude-local.mjs",
    "check:purge": "node scripts/check-purge-local.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run typecheck:functions && npm run lint && npm run test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@10play/tentap-editor": "1.1.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "expo": "~54.0.37",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/src/test-utils/jestSetup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@10play/tentap-editor/src))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "private": true
}
