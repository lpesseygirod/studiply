# Copy to `.env.remote` (git-ignored) to run the app against the remote
# Supabase project: `npm run start:remote`. `.env` stays local and is the
# default; `npm run start:local` switches back.
#
# Only public values: the project URL and its anon key (Dashboard → Project
# Settings → API Keys → Legacy → anon, or `supabase projects api-keys`).
# NEVER the service_role key or an sb_secret_ key: start-remote.mjs refuses them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_remote_anon_key_here

# Optional, development only: simulated AI (see .env.example).
# EXPO_PUBLIC_MOCK_AI=1
