# Local secrets for Edge Functions. Copy to supabase/functions/.env (git-ignored)
# and type the keys after the = signs. Never commit the real file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Transcription: Scribe v2 (ElevenLabs) needs ELEVENLABS_API_KEY.
# TRANSCRIBE_PROVIDER=elevenlabs says so explicitly (empty means the same);
# `openai` goes back to whisper-1 only while the consent text names OpenAI.
TRANSCRIBE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Any long random string (openssl rand -hex 32); purge-trash accepts only
# calls that send it. The remote has its own (supabase secrets set).
CRON_SECRET=
# Step 10.1, delete-account: revoking a student's Sign in with Apple token when
# her account is deleted (Apple's rule). From the Apple Developer account:
# your Team ID, the Sign in with Apple key's Key ID, the key itself (the whole
# .p8 text; \n for its line breaks is fine), the app's bundle id and the web's
# Services ID. Empty: accounts are still deleted; the revocation is skipped and
# logged as skipped. The remote has its own (supabase secrets set).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.studiply.app
APPLE_SERVICES_ID=
