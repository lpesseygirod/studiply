# Local secrets for Edge Functions. Copy to supabase/functions/.env (git-ignored)
# and type the keys after the = signs. Never commit the real file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Transcription: Scribe v2 (ElevenLabs) needs ELEVENLABS_API_KEY.
# TRANSCRIBE_PROVIDER=elevenlabs says so explicitly (empty means the same);
# `openai` goes back to whisper-1 only while the consent text names OpenAI.
TRANSCRIBE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Any long random string (openssl rand -hex 32); purge-trash accepts only
# calls that send it. The remote has its own (supabase secrets set).
CRON_SECRET=
