# Optional. Without these, the app runs on its mock AI pipeline and every
# non-AI feature still works. Copy to `.env` and add your own keys to enable
# real transcription and note generation.
#
# Note: Expo inlines EXPO_PUBLIC_* vars into the JS bundle, so keys set here
# are readable in any build you distribute. Use keys with a spend limit.

EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here
