# Copy to `.env` for local development. Expo inlines every EXPO_PUBLIC_*
# variable into the app bundle, so only public values belong here.
#
# There are no AI keys in the app. Transcription and Claude run in the
# Supabase Edge Functions, which read OPENAI_API_KEY and ANTHROPIC_API_KEY
# on the server: locally from supabase/functions/.env (see
# supabase/functions/.env.example), remotely from `supabase secrets set`.

# Supabase. For development these point at local Supabase:
# run `supabase start`, then copy "API URL" and "anon key" from `supabase status`.
# The anon key is public by design (Row Level Security protects the data).
# NEVER put the service_role key here or anywhere in the app: it bypasses RLS.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here

# Step 10.1, Sign in with Apple on the web version (Apple's JS sign-in). Both
# are public (the browser sends them to Apple anyway): the web's Services ID
# from Apple Developer → Identifiers, and a return URL registered on it. Empty:
# the web's Continue with Apple says it isn't set up yet. The iPhone needs
# neither (its bundle id is the client).
# EXPO_PUBLIC_APPLE_SERVICES_ID=
# EXPO_PUBLIC_APPLE_REDIRECT_URI=

# Optional, development only: 1 = simulated transcripts and notes (nothing
# is sent to OpenAI or Anthropic, nothing is counted). Ignored in store builds.
# EXPO_PUBLIC_MOCK_AI=1
