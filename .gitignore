# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# EAS local credentials (Studiply uses EAS-managed signing; never commit these)
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit real keys
.env
.env*.local
.env.remote
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# logs
*.log
logs/

# env variants not covered above
.env.development
.env.production
.env.staging
.env.test

# EAS / build output
.eas/
*.ipa
*.apk
*.aab
*.tar.gz
ios/build/
android/build/
android/app/build/
android/.gradle/
*.keystore
!debug.keystore

# native crash/profiling artifacts
*.hprof

# editor + tooling
.vscode/
.idea/
*.swp
coverage/
.claude/settings.local.json

# Finder/iCloud duplicate copies ("file 2.ts", "folder 2")
* 2.*
* 2

# Editor bundle (step 4.2): editorHtml.js is committed for Metro and EAS; the plain HTML is a build step
editor-web/build/index.html

# Reports and review notes (kept on this Mac only)
docs/reports/

# Real lectures as test fixtures (step 7.1) and the summaries written from them (7.4): never in git
tests/fixtures/
tests/output/
