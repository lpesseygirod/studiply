{
  "expo": {
    "name": "Studiply",
    "slug": "studiply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "studiply",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B8B5E4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studiply.app",
      "usesAppleSignIn": true,
      "backgroundColor": "#B8B5E4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Studiply uses the microphone only while you record a lecture, so you can replay it and turn it into notes. Recording continues when the screen locks.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C9A8D4"
      },
      "package": "com.studiply.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Studiply uses the microphone only while you record a lecture, so you can replay it and turn it into notes. Recording continues when the screen locks."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of slides, notes or the whiteboard to add to a lecture or a document.",
          "cameraPermission": "Take photos of the whiteboard or slides during a lecture; they're added to that lecture's notes."
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Studiply uses the microphone only while you record a lecture, so you can replay it and turn it into notes. Recording continues when the screen locks.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5dbd5dec-dab7-4885-aef3-4227a8a4aa8e"
      }
    },
    "owner": "leapessey"
  }
}
