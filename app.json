{
  "expo": {
    "name": "Studiply",
    "slug": "studiply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "studiply",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B8B5E4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studiply.app",
      "backgroundColor": "#B8B5E4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Studiply needs microphone access to record lectures.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C9A8D4"
      },
      "package": "com.studiply.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Studiply needs microphone access to record lectures."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Studiply needs access to your photos to upload images.",
          "cameraPermission": "Studiply needs camera access to take photos of whiteboards and slides."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
